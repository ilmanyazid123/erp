// Managemen Tokoku — Prisma schema for PostgreSQL (Neon / Vercel Postgres / Supabase)
// Models: User, Business (workspace), Branch, Warehouse, Product, Customer,
// Supplier, InventoryItem, StockMovement, PurchaseOrder (+items), SalesOrder
// (+items), Invoice, Payment, Approval, ChatMessage, Subscription, AuditLog.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")        // Pooled connection (PgBouncer) for app runtime / serverless functions
  directUrl  = env("DIRECT_URL")          // Direct connection for migrations (db:push / db:migrate)
}

/* ------------------------------------------------------------------ */
/* Authentication & workspace                                           */
/* ------------------------------------------------------------------ */
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  role          UserRole @default(MEMBER)
  // Reference to the business (workspace) the user belongs to. Set on
  // registration when the user creates a new business.
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
  chatMessages  ChatMessage[]
  approvals     Approval[]
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

model Business {
  id          String   @id @default(cuid())
  name        String
  // Slug is the workspace key used for subdomain-style routing (not yet
  // implemented; reserved for future use).
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  branches    Branch[]
  warehouses  Warehouse[]
  products    Product[]
  customers   Customer[]
  suppliers   Supplier[]
  purchases   PurchaseOrder[]
  sales       SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]
  chatMessages ChatMessage[]
  subscription Subscription?
}

model Branch {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouses  Warehouse[]
}

model Warehouse {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name        String
  code        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory   InventoryItem[]
  stockMovements StockMovement[]
}

/* ------------------------------------------------------------------ */
/* Master data                                                          */
/* ------------------------------------------------------------------ */
model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sku         String
  barcode     String?  // EAN-13/UPC/QR — scanned at sales & purchasing input
  name        String
  category    String?
  brand       String?
  unit        String?
  priceSell   Float    @default(0)
  priceBuy    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory   InventoryItem[]
  stockMovements StockMovement[]
  purchaseItems PurchaseOrderItem[]
  salesItems  SalesOrderItem[]

  @@unique([businessId, sku])
  @@index([businessId, barcode])
}

model Customer {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales       SalesOrder[]
  invoices    Invoice[] @relation("CustomerInvoices")
}

model Supplier {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases   PurchaseOrder[]
  invoices    Invoice[] @relation("SupplierInvoices")
}

/* ------------------------------------------------------------------ */
/* Inventory                                                            */
/* ------------------------------------------------------------------ */
model InventoryItem {
  id          String   @id @default(cuid())
  businessId  String
  // Implicit relation — we keep businessId for fast scoping without joins.
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Float    @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([warehouseId, productId])
}

model StockMovement {
  id          String   @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // IN, OUT, ADJUSTMENT, TRANSFER
  type        String
  quantity    Float
  reason      String?
  refType     String?
  refId       String?
  createdAt   DateTime @default(now())
}

/* ------------------------------------------------------------------ */
/* Purchasing & Sales                                                   */
/* ------------------------------------------------------------------ */
model PurchaseOrder {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  code        String
  status      String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, RECEIVED, CANCELLED
  total       Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PurchaseOrderItem[]

  @@unique([businessId, code])
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Float
  price       Float
  total       Float
}

model SalesOrder {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  code        String
  status      String   @default("DRAFT") // DRAFT, CONFIRMED, DELIVERED, INVOICED, CANCELLED
  total       Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       SalesOrderItem[]

  @@unique([businessId, code])
}

model SalesOrderItem {
  id          String     @id @default(cuid())
  orderId     String
  order       SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Float
  price       Float
  total       Float
}

/* ------------------------------------------------------------------ */
/* Finance                                                              */
/* ------------------------------------------------------------------ */
model Invoice {
  id          String   @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Type: SALES to customer, or PURCHASE from supplier.
  type        String
  code        String
  // For SALES invoices
  customerId  String?
  customer    Customer? @relation("CustomerInvoices", fields: [customerId], references: [id], onDelete: SetNull)
  // For PURCHASE invoices
  supplierId  String?
  supplier    Supplier? @relation("SupplierInvoices", fields: [supplierId], references: [id], onDelete: SetNull)
  refType     String? // SalesOrder / PurchaseOrder
  refId       String?
  amount      Float    @default(0)
  paidAmount  Float    @default(0)
  status      String   @default("UNPAID") // UNPAID, PARTIAL, PAID, CANCELLED
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    Payment[]

  @@unique([businessId, code])
}

model Payment {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  // SALES_RECEIPT or PURCHASE_DISBURSEMENT
  type        String
  amount      Float
  method      String? // CASH, BANK, QRIS, TRANSFER
  notes       String?
  createdAt   DateTime @default(now())
}

/* ------------------------------------------------------------------ */
/* Approval workflow                                                    */
/* ------------------------------------------------------------------ */
model Approval {
  id          String   @id @default(cuid())
  businessId  String
  // We do not enforce a relation from Approval to Business because approvals
  // may target entities across multiple tables (Purchase, Discount, etc.)
  // — keep it loose for SQLite simplicity.
  refType     String
  refId       String
  action      String   // APPROVE / REJECT / CANCEL
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  notes       String?
  requestedById String?
  requestedBy User?    @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
}

/* ------------------------------------------------------------------ */
/* Team chat & collaboration                                            */
/* ------------------------------------------------------------------ */
model ChatMessage {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel     String   @default("general")
  content     String
  createdAt   DateTime @default(now())
}

/* ------------------------------------------------------------------ */
/* Subscription & billing                                              */
/* ------------------------------------------------------------------ */
model Subscription {
  id          String   @id @default(cuid())
  businessId  String   @unique
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan        String   @default("Starter") // Starter, Team, Growth, Unlimited
  status      String   @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELLED
  trialEndsAt DateTime?
  currentPeriodEnd DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/* ------------------------------------------------------------------ */
/* Audit log                                                            */
/* ------------------------------------------------------------------ */
model AuditLog {
  id          String   @id @default(cuid())
  businessId  String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String?
  entityId     String?
  metadata    String? // JSON serialized
  createdAt   DateTime @default(now())
}
